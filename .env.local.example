# ─────────────────────────────────────────────────────────────────────────────
# AirGuard — Local Development Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# .env.local is loaded by Docker Compose and the backend automatically.
# NEVER commit .env.local to source control.
# ─────────────────────────────────────────────────────────────────────────────

AIRGUARD_ENV=local

# ── Airflow ──────────────────────────────────────────────────────────────────
# Inside Docker the backend reaches Airflow via the Docker service name.
# Outside Docker (running backend directly) use localhost:8080.
AIRFLOW_API_URL=http://airflow-webserver:8080/api/v1
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Amazon Bedrock AgentCore (optional — leave blank to run tools directly)
# AGENTCORE_HARNESS_ID=arn:aws:bedrock-agentcore:us-east-1:123456789:harness/harness_xxx

# ── Slack ─────────────────────────────────────────────────────────────────────
# Create a Slack app at https://api.slack.com/apps and add a Bot Token.
# Required scopes: chat:write, channels:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-channel-id

# ── AirGuard Webhook Auth ─────────────────────────────────────────────────────
# Token that Airflow DAGs send in the X-AirGuard-Token header.
# Must match the value in dags/airguard_callbacks.py.
AIRGUARD_WEBHOOK_TOKEN=airguard-local-dev-secret-2026

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=airguard
POSTGRES_PASSWORD=airguard_password
POSTGRES_DB=airguard
REDIS_HOST=redis
